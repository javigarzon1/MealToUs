# Copia este fichero a `.env` (docker compose lo lee solo) y rellénalo.

# Clave para firmar las sesiones. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Proveedor LLM: anthropic | openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Opcionales
# COOKIE_SECURE=false       # true si publicas la web por HTTPS
# ALLOW_REGISTRATION=true   # false para cerrar el alta de usuarios

# --- Recuperar contraseña ---
# URL pública de la web: se usa para el enlace del correo.
# APP_BASE_URL=http://localhost:5173        (con Docker: http://localhost:8080)
# Sin SMTP_HOST el correo NO se envía: el enlace aparece en el log del backend.
# SMTP_HOST=smtp.tuservidor.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=MealToUs <no-reply@tudominio.com>

# --- Otros proveedores (API compatible con OpenAI) ---
# Gemini (clave gratuita en https://aistudio.google.com/apikey):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=<modelo gemini flash disponible en AI Studio>
#   OPENAI_API_KEY=<tu clave de AI Studio>
# Groq (clave gratuita en https://console.groq.com/keys):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=<modelo disponible en la consola de Groq>
#   OPENAI_API_KEY=<tu clave de Groq>

# Tope de tokens de respuesta (0 = sin tope). Con Groq gratuito (8000 tokens/minuto) usa p. ej. 5000.
# LLM_MAX_TOKENS=5000

# --- Segundo proveedor solo para la lista de la compra (opcional) ---
# Sin SHOPPING_LLM_PROVIDER, la lista usa el proveedor principal. Las recetas siempre usan el principal.
# Ejemplo: Groq para todo y Gemini (clave gratuita) para la compra.
# SHOPPING_LLM_PROVIDER=openai
# SHOPPING_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# SHOPPING_LLM_MODEL=gemini-3.5-flash-lite
# Sin el prefijo "models/". Google retira modelos con el tiempo (un 404 suele indicar
# que el modelo ya no existe para tu cuenta): consulta los vigentes en ai.google.dev.
# Una variable de entorno ya exportada en la terminal gana al .env; si cambias el .env
# y nada cambia, revisa `env | grep LLM_` o arranca con SHOPPING_LLM_MODEL=... delante.
# SHOPPING_LLM_API_KEY=
# SHOPPING_LLM_MAX_TOKENS=0
