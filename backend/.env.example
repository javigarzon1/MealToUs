# Proveedor LLM: anthropic | openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DATABASE_URL=sqlite:///./mealtous.db

# --- Autenticación ---
# Genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# TOKEN_DAYS=7
# COOKIE_SECURE=false   # true si sirves el backend por HTTPS propio
# ALLOW_REGISTRATION=true

# --- Recuperar contraseña ---
# URL pública de la web: se usa para el enlace del correo.
# APP_BASE_URL=http://localhost:5173        (con Docker: http://localhost:8080)
# Sin SMTP_HOST el correo NO se envía: el enlace aparece en el log del backend.
# SMTP_HOST=smtp.tuservidor.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=MealToUs <no-reply@tudominio.com>

# --- Otros proveedores (API compatible con OpenAI) ---
# Gemini (clave gratuita en https://aistudio.google.com/apikey):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=<modelo gemini flash disponible en AI Studio>
#   OPENAI_API_KEY=<tu clave de AI Studio>
# Groq (clave gratuita en https://console.groq.com/keys):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=<modelo disponible en la consola de Groq>
#   OPENAI_API_KEY=<tu clave de Groq>

# --- Plan B automático ---
# Si defines el segundo proveedor (SHOPPING_LLM_*), además de generar la lista de la compra
# hace de paracaídas: cuando el principal falla (límite de tokens, error de API o respuestas
# inválidas), la misma petición se repite con él. Ejemplo con Gemini:
#   SHOPPING_LLM_PROVIDER=openai
#   SHOPPING_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   SHOPPING_LLM_MODEL=gemini-3.5-flash-lite
#   SHOPPING_LLM_API_KEY=<tu clave de AI Studio>

# --- Foto de la nevera/despensa ---
# Necesita un modelo con visión. Usa el segundo proveedor (SHOPPING_LLM_*, p. ej. Gemini
# gemini-3.5-flash-lite) o, si no hay, el principal cuando es Anthropic. gpt-oss de Groq es solo texto.
